{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PUSH_REGISTER_URL": "https://backend.dawahbox.com/api/register_push_token.php",
        "EXPO_PUBLIC_POSTHOG_KEY": "phc_WZcuuwHzWZEmX4PKpoZhL2aQuuRaiVL07LHOs8KlBo6"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_PUSH_REGISTER_URL": "https://backend.dawahbox.com/api/register_push_token.php",
        "EXPO_PUBLIC_POSTHOG_KEY": "phc_WZcuuwHzWZEmX4PKpoZhL2aQuuRaiVL07LHOs8KlBo6"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_PUSH_REGISTER_URL": "https://backend.dawahbox.com/api/register_push_token.php",
        "EXPO_PUBLIC_POSTHOG_KEY": "phc_WZcuuwHzWZEmX4PKpoZhL2aQuuRaiVL07LHOs8KlBo6"
      },
      "channel": "production"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "development",
      "channel": "development-simulator"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "Y26B3N2A8U"
      }
    },
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
