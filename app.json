{
  "expo": {
    "name": "dawahnigeria",
    "slug": "dawah-nigeria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dawahnigeria",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dawahnigeria.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "associatedDomains": [
        "applinks:dawahnigeria.com"
      ]
    },
    "android": {
      "package": "com.dawahnigeria.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dawahnigeria.com",
              "pathPrefix": "/dawahcast/l"
            },
            {
              "scheme": "https",
              "host": "dawahnigeria.com",
              "pathPrefix": "/dawahcast/a"
            },
            {
              "scheme": "https",
              "host": "dawahnigeria.com",
              "pathPrefix": "/dawahcast/p"
            },
            {
              "scheme": "https",
              "host": "dawahnigeria.com",
              "pathPrefix": "/dawahcast/rp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-audio",
        {
          "audioMode": {
            "playsInSilentModeIOS": true,
            "staysActiveInBackground": true
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "dawah-nigeria",
          "organization": "yusuf-adeyemo"
        }
      ],
      "expo-notifications",
      "expo-asset",
      "expo-font",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/f7c0926f-13d1-4a2f-bfb1-3f9c04f2577b"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7c0926f-13d1-4a2f-bfb1-3f9c04f2577b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}