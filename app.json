{
  "expo": {
    "name": "dawahnigeria",
    "slug": "dawah-nigeria",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "assets/**/*",
      "node_modules/**/node_modules/@expo/vector-icons/**/Fonts/Ionicons.ttf"
    ],
    "scheme": "dawahnigeria",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dawahnigeria.app",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:dawahnigeria.com"
      ]
    },
    "android": {
      "package": "com.dawahnigeria.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dawahnigeria.com",
              "pathPrefix": "/dawahcast/l"
            },
            {
              "scheme": "https",
              "host": "dawahnigeria.com",
              "pathPrefix": "/dawahcast/a"
            },
            {
              "scheme": "https",
              "host": "dawahnigeria.com",
              "pathPrefix": "/dawahcast/p"
            },
            {
              "scheme": "https",
              "host": "dawahnigeria.com",
              "pathPrefix": "/dawahcast/rp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 420,
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 420,
            "resizeMode": "cover",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "dawah-native",
          "organization": "prontoville"
        }
      ],
      "expo-notifications",
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      "expo-localization",
      "@sentry/react-native",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.739832430566-i4h4ftr4hedrg6anghbv2bnvvdlgrvus"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "audioMode": {
            "playsInSilentModeIOS": true,
            "staysActiveInBackground": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          },
          "android": {
            "reactNativeReleaseLevel": "stable",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-image",
      "expo-iap",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/f7c0926f-13d1-4a2f-bfb1-3f9c04f2577b"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7c0926f-13d1-4a2f-bfb1-3f9c04f2577b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
