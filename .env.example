# Copy this file to .env and fill in your values

# Expo Public Variables (accessible in React Native code)
# Note: Expo requires EXPO_PUBLIC_ prefix for client-side variables
EXPO_PUBLIC_API_BASE_URL=https://backend.dawahbox.com
EXPO_PUBLIC_API_PROJECT_KEY=your_project_key_here
EXPO_PUBLIC_MEDIA_BASE_URL=https://media.dawahnigeria.com
EXPO_PUBLIC_PUSH_REGISTER_URL=https://backend.dawahbox.com/api/push/register.php

# Environment
EXPO_PUBLIC_NODE_ENV=development

# Optional: Analytics
# ANALYTICS_KEY=your_analytics_key_here

# Google Sign-In (Web Client ID from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here

# Native subscriptions (must match App Store Connect and Google Play product IDs)
EXPO_PUBLIC_PREMIUM_MONTHLY_PRODUCT_ID=dawahnigeria_premium_monthly
EXPO_PUBLIC_PREMIUM_YEARLY_PRODUCT_ID=dawahnigeria_premium_yearly

# Optional: Error Tracking (Sentry)
# SENTRY_DSN=your_sentry_dsn_here
# SENTRY_ORG=your_organization
# SENTRY_PROJECT=your_project_name

# Optional: Feature Flags
# ENABLE_OFFLINE_MODE=false
# ENABLE_PUSH_NOTIFICATIONS=false

# Optional: Cache Configuration
# CACHE_TTL=3600000 # 1 hour in milliseconds
# MAX_CACHE_SIZE=50 # Maximum number of cached items
