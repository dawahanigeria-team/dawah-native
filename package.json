{
  "name": "dawahnigeria",
  "main": "AppEntry.js",
  "version": "1.0.0",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "android:build:preview:local": "eas build -p android --profile preview --local --output builds/app-preview.apk",
    "android:build:production:local": "eas build -p android --profile production --local --output builds/app-production.aab",
    "build:android": "expo run:android --variant release",
    "build:android:apk": "cd android && ./gradlew assembleRelease && cd ..",
    "build:android:aab": "cd android && ./gradlew bundleRelease && cd ..",
    "build:android:dev": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "eas:dev:android": "eas build --profile development --platform android",
    "eas:dev:ios": "eas build --profile development --platform ios",
    "eas:dev:all": "eas build --profile development --platform all",
    "eas:preview:android": "eas build --profile preview --platform android",
    "eas:preview:ios": "eas build --profile preview --platform ios",
    "eas:prod:android": "eas build --profile production --platform android",
    "eas:prod:ios": "eas build --profile production --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@sentry/react-native": "~8.8.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.2",
    "expo-apple-authentication": "~57.0.0",
    "expo-application": "~57.0.0",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.0",
    "expo-blur": "~57.0.0",
    "expo-build-properties": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-iap": "^4.2.1",
    "expo-image": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-localization": "~57.0.0",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.0",
    "simpler-state": "^1.2.2",
    "twrnc": "^4.9.1"
  },
  "devDependencies": {
    "@sentry/cli": "^3.1.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-atlas": "^0.4.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
